{
  "name": "talvext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:login": "node scripts/capture-screenshots.mjs login",
    "prepare": "git config core.hooksPath .githooks",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:dump": "d=backups/$(date -u +%Y%m%dT%H%M%SZ) && mkdir -p $d && supabase db dump --linked -f $d/schema.sql && supabase db dump --linked --data-only --use-copy -f $d/data.sql && echo \"Dumped to $d. This file holds every tenant row: do not commit it, delete it when you are done.\""
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.21",
    "@supabase/supabase-js": "^2.110.8",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "1.54.1",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
