# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values. .env.example is the one exception:
# it holds names and placeholders only, so it must stay tracked.
.env*
!.env.example

# screenshot capture session (holds Clerk session tokens; never commit)
/.auth/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database dumps (npm run db:dump). These hold every tenant row.
/backups

# design handoff bundle, kept locally and deliberately not committed. These
# are large generated prototype exports, not source. The tracked design entry
# point is docs/design/DESIGN.md, and docs/design/handoff/README.md is the
# reconciled copy of the bundle's own README (see the 2026-07-24 decision).
# The .dc.html prototypes have no tracked counterpart and are not meant to;
# nothing here is deleted, it is simply not the repository's business.
/design_handoff_talvex_app/
/Talvex Landing.dc.html
